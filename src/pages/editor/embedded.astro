        }

        // Autosave
        let timer;
        editorInstance.onDidChangeModelContent(() => {
          clearTimeout(timer);
          timer = setTimeout(() => saveToCloud(editorInstance.getValue()), 500);
        });

        // Buttons
        saveBtn.addEventListener("click", () => saveToCloud(editorInstance.getValue()));
        
        resetBtn.addEventListener("click", () => {
          const template = starterTemplates[starterId] || genericTemplate(starterId);
          editorInstance.setValue(template);
          saveToCloud(template);
          applyMarkers([]);
          setStatus("Reset to starter");
        });

        downloadBtn.addEventListener("click", () => {
          const blob = new Blob([editorInstance.getValue()], { type: "text/plain" });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.download = "Program.cs";
          link.click();
          URL.revokeObjectURL(url);
          setStatus("Downloaded");
        });

        // Pop-out button - open editor in new window
        const popoutBtn = document.getElementById("popout-btn");
        popoutBtn.addEventListener("click", () => {
          // Save current code first
          saveToCloud(editorInstance.getValue());
          // Open the embedded editor in a new window (no sidebar/nav)
          const editorUrl = `/editor/embedded?starter=${encodeURIComponent(starterId)}`;
          window.open(editorUrl, '_blank', 'width=1200,height=800,menubar=no,toolbar=no,location=no,status=no');
          setStatus("Opened in new window");
        });

        // Stdin input handling - show if WebSocket not configured (fallback mode)
        const stdinSection = document.getElementById("stdin-section");
        const stdinInput = document.getElementById("stdin-input");
        const stdinHeader = document.getElementById("stdin-header");
        const stdinContent = document.getElementById("stdin-content");
        const stdinToggle = document.getElementById("stdin-toggle");
        
        if (envRunnerWsUrl) {
          // WebSocket available - hide stdin section
          if (stdinSection) stdinSection.style.display = 'none';
        } else {
          // Fallback mode - show stdin section
          if (stdinSection) stdinSection.style.display = 'block';
          if (stdinHeader) {
            stdinHeader.addEventListener("click", () => {
              stdinContent.classList.toggle("collapsed");
              stdinToggle.textContent = stdinContent.classList.contains("collapsed") ? "▸" : "▾";
            });
          }
        }

        // Interactive run via WebSocket
        const runInteractive = () => {
          if (!editorInstance) return;
          
          // Close any existing connection
          if (currentWs) {
            currentWs.close();
            currentWs = null;
          }

          initTerminal();
          clearTerminal();
          openDrawer();
          
          // Switch to terminal tab
          document.querySelectorAll(".output-tab").forEach(t => {
            const isTerminal = t.dataset.tab === "terminal";
            t.classList.toggle("active", isTerminal);
            t.setAttribute("aria-selected", isTerminal ? "true" : "false");
          });
          document.querySelectorAll(".tab-pane").forEach(p => {
            const isTerminal = p.id === "tab-terminal";
            p.classList.toggle("active", isTerminal);
            if (isTerminal) { p.removeAttribute("hidden"); } else { p.setAttribute("hidden", ""); }
          });
          fitAddon?.fit();

          setBusy(true, "Connecting...");
          outputStatus.textContent = "Connecting...";
          writeToTerminal('\x1b[36mConnecting to runner...\x1b[0m\r\n');

          // Build WebSocket URL - needs direct runner URL (can't go through Netlify proxy)
          if (!envRunnerWsUrl) {
            writeToTerminal('\x1b[31mERROR: Interactive terminal not configured.\x1b[0m\r\n');
            writeToTerminal('\x1b[33mFalling back to batch mode...\x1b[0m\r\n');
            // Fall back to HTTP mode
            const stdinInput = document.getElementById("stdin-input");
            const stdin = stdinInput?.value || "";
            runnerRequest("/api/run", buildPayload(editorInstance.getValue(), stdin), "run");
            return;
          }
          
          const wsUrl = envRunnerWsUrl + '/ws/run';
          
          try {
            currentWs = new WebSocket(wsUrl);
          } catch (err) {
            writeToTerminal('\x1b[31mERROR: Failed to connect: ' + err.message + '\x1b[0m\r\n');
            setBusy(false);
            outputStatus.textContent = "Connection failed";
            return;
          }

          currentWs.onopen = () => {
            writeToTerminal('\x1b[32mConnected\x1b[0m\r\n');
            // Send the code
            currentWs.send(JSON.stringify({
              code: editorInstance.getValue(),
              starterId: starterId
            }));
          };

          currentWs.onmessage = (event) => {
            try {
              const msg = JSON.parse(event.data);
              
              switch (msg.type) {
                case 'status':
                  outputStatus.textContent = msg.message;
                  writeToTerminal('\x1b[36m' + msg.message + '\x1b[0m\r\n');
                  break;
                  
                case 'started':
                  outputStatus.textContent = "Running (type input below)";
                  writeToTerminal('\x1b[32m─── Program Started ───\x1b[0m\r\n');
                  writeToTerminal('\x1b[90m(Type input below and press Enter)\x1b[0m\r\n\r\n');
                  setStatus("Running");
                  setBusy(false); // Allow typing
                  setTimeout(() => term.focus(), 50);
                  break;
                  
                case 'stdout':
                  term.write(msg.data.replace(/\n/g, '\r\n'));
                  break;
                  
                case 'stderr':
                  term.write('\x1b[31m' + msg.data.replace(/\n/g, '\r\n') + '\x1b[0m');
                  stderrBlock.textContent = (stderrBlock.textContent === '(no errors yet)' ? '' : stderrBlock.textContent) + msg.data;
                  break;
                  
                case 'stdin_echo':
                  // Input is echoed - already displayed by terminal
                  break;
                  
                case 'compile_error':
                  writeToTerminal('\r\n\x1b[31mCompilation Failed\x1b[0m\r\n');
                  if (msg.diagnostics) {
                    msg.diagnostics.forEach(d => {
                      writeToTerminal(`\x1b[31m  Line ${d.Line}: ${d.Message}\x1b[0m\r\n`);
                    });
                  }
                  if (msg.stderr) {
                    stderrBlock.textContent = msg.stderr;
                  }
                  applyMarkers(msg.diagnostics || []);
                  outputStatus.textContent = "Compile error";
                  setStatus("Compile error");
                  setBusy(false);
                  break;
                  
                case 'exited':
                  writeToTerminal('\r\n\x1b[32m─── Program Exited (code: ' + msg.exitCode + ') ───\x1b[0m\r\n');
                  outputStatus.textContent = msg.exitCode === 0 ? "Completed" : `Exited (${msg.exitCode})`;
                  setStatus("Ready");
                  setBusy(false);
                  break;
                  
                case 'timeout':
                  writeToTerminal('\r\n\x1b[31mTIMEOUT: ' + msg.message + '\x1b[0m\r\n');
                  outputStatus.textContent = "Timed out";
                  setStatus("Ready");
                  setBusy(false);
                  break;
                  
                case 'error':
                  writeToTerminal('\r\n\x1b[31mERROR: ' + msg.message + '\x1b[0m\r\n');
                  outputStatus.textContent = "Error";
                  setStatus("Ready");
                  setBusy(false);
                  break;
              }
            } catch (err) {
              console.error('WS message parse error:', err);
            }
          };

          currentWs.onerror = (err) => {
            writeToTerminal('\x1b[31mWebSocket error\x1b[0m\r\n');
            outputStatus.textContent = "Connection error";
            setStatus("Error");
            setBusy(false);
          };

          currentWs.onclose = () => {
            if (outputStatus.textContent === "Running (type input below)") {
              writeToTerminal('\r\n\x1b[33mConnection closed\x1b[0m\r\n');
              outputStatus.textContent = "Disconnected";
            }
            setStatus("Ready");
            setBusy(false);
            currentWs = null;
          };
        };

        runBtn.addEventListener("click", runInteractive);

        checkBtn.addEventListener("click", () => {
          if (!editorInstance) return;
          // Check still uses HTTP (needs stdin pre-filled for automated checks)
          const stdinInput = document.getElementById("stdin-input");
          const stdin = stdinInput?.value || "";
          runnerRequest("/api/check", buildPayload(editorInstance.getValue(), stdin), "check");
        });

        // Keyboard shortcuts
        editorInstance.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.Enter, () => runBtn.click());

        setStatus("Ready");
        initTerminal(); // Initialize terminal on load
      };

      initEditor();
    })();
  </script>


            { label: 'RemoveAt', text: 'RemoveAt($0)', detail: 'void RemoveAt(int index)', doc: 'Removes item at index.' },
            { label: 'Clear', text: 'Clear()', detail: 'void Clear()', doc: 'Removes all items.' },
            { label: 'Contains', text: 'Contains($0)', detail: 'bool Contains(T item)', doc: 'Checks if item exists.' },

          ];

          // Namespaces
          const NAMESPACES = [
            { name: 'System', doc: 'Fundamental classes and base types.' },
            { name: 'System.Collections.Generic', doc: 'Generic collections like List<T>.' },
            { name: 'System.Linq', doc: 'LINQ queries.' },
            { name: 'System.Text', doc: 'Text encoding.' },
            { name: 'System.IO', doc: 'File and stream I/O.' },
          ];

          // Register completion provider
          monaco.languages.registerCompletionItemProvider('csharp', {
            triggerCharacters: ['.', ' '],
            provideCompletionItems: (model, position) => {
              const word = model.getWordUntilPosition(position);
              const range = {
                startLineNumber: position.lineNumber,
                endLineNumber: position.lineNumber,
                startColumn: word.startColumn,
                endColumn: word.endColumn
              };

              const lineContent = model.getLineContent(position.lineNumber);
              const textBefore = lineContent.substring(0, position.column - 1);
              const suggestions = [];

              // Helper to add members
              const addMembers = (members) => {
                members.forEach(m => {
                  suggestions.push({
                    label: m.label,
                    kind: m.isProp ? monaco.languages.CompletionItemKind.Property : monaco.languages.CompletionItemKind.Method,
                    insertText: m.text,
                    insertTextRules: m.text.includes('$') ? monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet : undefined,
                    detail: m.detail,
                    documentation: m.doc,
                    range
                  });
                });
              };

              // After "using "
              if (textBefore.match(/using\s+$/)) {
                NAMESPACES.forEach(ns => {
                  suggestions.push({
                    label: ns.name,
                    kind: monaco.languages.CompletionItemKind.Module,
                    insertText: ns.name + ';',
                    detail: 'namespace',
                    documentation: ns.doc,
                    range
                  });
                });
                return { suggestions };
              }

              // After "Console."
              if (textBefore.match(/Console\.$/)) {
                addMembers(CONSOLE_MEMBERS);
                return { suggestions };
              }

              // After "Math."
              if (textBefore.match(/Math\.$/)) {
                addMembers(MATH_MEMBERS);
                return { suggestions };
              }

              // After "Convert."
              if (textBefore.match(/Convert\.$/)) {
                addMembers(CONVERT_MEMBERS);
                return { suggestions };
              }

              // After "int."
              if (textBefore.match(/int\.$/)) {
                addMembers(INT_MEMBERS);
                return { suggestions };
              }

              // After "double."
              if (textBefore.match(/double\.$/)) {
                addMembers(DOUBLE_MEMBERS);
                return { suggestions };
              }

              // After "decimal."
              if (textBefore.match(/decimal\.$/)) {
                addMembers(DECIMAL_MEMBERS);
                return { suggestions };
              }

              // After list variable (common names)
              if (textBefore.match(/\b(list|items|collection|numbers|names|words|data)\.\s*$/i)) {
                addMembers(LIST_MEMBERS);
                return { suggestions };
              }

              // After string variable or literal
              if (textBefore.match(/"\s*\.\s*$/) || textBefore.match(/\b(str|name|text|input|line|word|s|message|response|answer)\.\s*$/i)) {
                addMembers(STRING_MEMBERS);
                return { suggestions };
              }

              // After any identifier with dot (general fallback)
              if (textBefore.match(/\w+\.\s*$/)) {
                addMembers(STRING_MEMBERS);
                suggestions.push({
                  label: 'ToString',
                  kind: monaco.languages.CompletionItemKind.Method,
                  insertText: 'ToString()',
                  detail: 'string ToString()',
                  documentation: 'Returns string representation.',
                  range
                });
                return { suggestions };
              }

              // General context - snippets, keywords, classes
              const currentWord = word.word.toLowerCase();

              // Snippets (highest priority)
              CODE_SNIPPETS.forEach(s => {
                if (currentWord === '' || s.label.toLowerCase().startsWith(currentWord)) {
                  suggestions.push({
                    label: s.label,
                    kind: monaco.languages.CompletionItemKind.Snippet,
                    insertText: s.text,
                    insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                    detail: s.detail,
                    range,
                    sortText: '0' + s.label
                  });
                }
              });

              // Keywords
              CSHARP_KEYWORDS.forEach(kw => {
                if (currentWord === '' || kw.toLowerCase().startsWith(currentWord)) {
                  suggestions.push({
                    label: kw,
                    kind: monaco.languages.CompletionItemKind.Keyword,
                    insertText: kw,
                    detail: 'keyword',
                    range,
                    sortText: '1' + kw
                  });
                }
              });

              // System classes
              SYSTEM_CLASSES.forEach(cls => {
                if (currentWord === '' || cls.name.toLowerCase().startsWith(currentWord)) {
                  suggestions.push({
                    label: cls.name,
                    kind: monaco.languages.CompletionItemKind.Class,
                    insertText: cls.name,
                    detail: cls.detail,
                    documentation: cls.doc,
                    range,
                    sortText: '2' + cls.name
                  });
                }
              });

              // Qualified Console methods
              if (currentWord === '' || 'console'.startsWith(currentWord)) {
                suggestions.push({
                  label: 'Console.WriteLine',
                  kind: monaco.languages.CompletionItemKind.Method,
                  insertText: 'Console.WriteLine($0);',
                  insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                  detail: 'void Console.WriteLine(string value)',
                  documentation: 'Writes a line to console output.',
                  range,
                  sortText: '3Console.WriteLine'
                });
                suggestions.push({
                  label: 'Console.Write',
                  kind: monaco.languages.CompletionItemKind.Method,
                  insertText: 'Console.Write($0);',
                  insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                  detail: 'void Console.Write(string value)',
                  documentation: 'Writes to console without newline.',
                  range,
                  sortText: '3Console.Write'
                });
                suggestions.push({
                  label: 'Console.ReadLine',
                  kind: monaco.languages.CompletionItemKind.Method,
                  insertText: 'Console.ReadLine()',
                  detail: 'string Console.ReadLine()',
                  documentation: 'Reads a line of input from the user.',
                  range,
                  sortText: '3Console.ReadLine'
                });
              }

              // Type parsing methods
              if (currentWord === '' || 'int'.startsWith(currentWord)) {
                suggestions.push({
                  label: 'int.Parse',
                  kind: monaco.languages.CompletionItemKind.Method,
                  insertText: 'int.Parse($0)',
                  insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                  detail: 'int int.Parse(string s)',
                  documentation: 'Converts string to int. Throws FormatException if invalid.',
                  range,
                  sortText: '3int.Parse'
                });
              }
              if (currentWord === '' || 'double'.startsWith(currentWord)) {
                suggestions.push({
                  label: 'double.Parse',
                  kind: monaco.languages.CompletionItemKind.Method,
                  insertText: 'double.Parse($0)',
                  insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
                  detail: 'double double.Parse(string s)',
                  documentation: 'Converts string to double. Throws FormatException if invalid.',
